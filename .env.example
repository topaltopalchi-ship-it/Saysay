# Copy these values into your local .env file or your build environment.
# Get them from Supabase Dashboard -> Project Settings -> API.
# These are public client values; NEVER put a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Trusted subscription API base URL (must validate Supabase Bearer JWTs).
VITE_BILLING_API_URL=
